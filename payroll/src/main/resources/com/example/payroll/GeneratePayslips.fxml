<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="756.0" style="-fx-background-color: #f5f5f5;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.payroll.GeneratePayslipsController"
            stylesheets="@generatePayslip.css"
>

    <Label layoutX="250" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Generate Payslip" />
    <Button layoutX="518.0" layoutY="23.0" onAction="#handleBackToDashboard" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Back to Dashboard" />


    <Label layoutX="50" layoutY="80" text="Select Employee:" />
    <ComboBox fx:id="employeeComboBox" layoutX="180" layoutY="75" onAction="#handleEmployeeSelect" prefWidth="300" />

    <TextArea fx:id="payslipArea" editable="false" layoutX="50" layoutY="130" prefHeight="270" prefWidth="600" style="-fx-font-family: monospace; -fx-font-size: 14px;" />

    <Button fx:id="exportButton" layoutX="50" layoutY="420" onAction="#handleExport" text="Export Payslip" />

    <Button layoutX="600" layoutY="420" onAction="#handleBack" text="Back" />
</AnchorPane>
