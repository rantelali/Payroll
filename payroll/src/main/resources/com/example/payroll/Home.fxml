<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.payroll.HomeController"
            prefWidth="600" prefHeight="400" stylesheets="@home.css"
>

    <Label layoutX="150.0" layoutY="50.0" text="Welcome to Payroll Management System"
           style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;" />

    <Label layoutX="120.0" layoutY="100.0" wrapText="true" maxWidth="360"
           text="This system helps your organization manage employee salaries, deductions, and generate pay slips securely and efficiently."
           style="-fx-font-size: 14px; -fx-text-fill: #34495e;" />

    <Button fx:id="registerButton" layoutX="170.0" layoutY="200.0" prefWidth="120.0" prefHeight="40.0"
            text="Register" onAction="#handleRegister" style="-fx-background-color: #3498db; -fx-text-fill: white;" />

    <Button fx:id="loginButton" layoutX="310.0" layoutY="200.0" prefWidth="120.0" prefHeight="40.0"
            text="Login" onAction="#handleLogin" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />

</AnchorPane>
