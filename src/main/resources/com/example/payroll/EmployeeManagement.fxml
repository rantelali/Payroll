<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" style="-fx-background-color: #f4f4f4;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.payroll.EmployeeManagementController" stylesheets="@employeeManagement.css">

    <Label layoutX="300" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Manage Employees" />


    <Button layoutX="592.0" layoutY="110.0" onAction="#handleBackToDashboard" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Back to Dashboard" />
    <Button layoutX="28.0" layoutY="110.0" onAction="#handleAdd" text="Add" />
    <Button layoutX="108.0" layoutY="110.0" onAction="#handleUpdate" text="Update" />
    <Button layoutX="214.0" layoutY="110.0" onAction="#handleDelete" text="Delete" />
    <Button layoutX="321.0" layoutY="110.0" onAction="#handleClear" text="Clear" />
    <Button layoutX="406.0" layoutY="110.0" onAction="#handleRegisterEmployee" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Register Employee" />


    <TableView fx:id="employeeTable" layoutX="28.0" layoutY="172.0" prefHeight="280" prefWidth="700">
        <columns>
            <TableColumn fx:id="idCol" prefWidth="61.0" text="ID" />
            <TableColumn fx:id="nameCol" prefWidth="160.0" text="Name" />
            <TableColumn fx:id="deptCol" prefWidth="133.0" text="Department" />
            <TableColumn fx:id="salaryCol" prefWidth="97.0" text="Salary" />
            <TableColumn fx:id="hoursCol" prefWidth="93.0" text="Hours" />
            <TableColumn fx:id="posCol" prefWidth="154.0" text="Position" />
        </columns>
    </TableView>
</AnchorPane>
